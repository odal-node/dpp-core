{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.odal-node.io/dpp/battery-v2.4.0.json",
  "title": "Odal Node — Battery Product Group Data (v2.4.0)",
  "description": "Battery-specific fields per EU Battery Regulation 2023/1542 Annex XIII. v2.4.0 adds expectedLifetime, the Annex VII Part B parameter set. Part B is narrower than Part A: it covers stationary battery energy storage systems and LMT batteries only, not electric-vehicle batteries. These are measured per-item values, which Annex XIII point 4(d) restricts to persons with a legitimate interest — distinct from expectedLifetimeCycles, the model-level design figure Annex XIII point 1(j) makes public.",
  "type": "object",
  "required": [
    "gtin",
    "batteryChemistry",
    "nominalVoltageV",
    "nominalCapacityAh",
    "expectedLifetimeCycles",
    "co2ePerUnitKg"
  ],
  "properties": {
    "gtin": {
      "type": "string",
      "pattern": "^[0-9]{14}$",
      "description": "14-digit Global Trade Item Number.",
      "x-disclosure": "public"
    },
    "batteryChemistry": {
      "type": "string",
      "minLength": 1,
      "description": "Battery chemistry code, e.g. LFP, NMC, LCO.",
      "x-disclosure": "public"
    },
    "nominalVoltageV": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Nominal voltage in volts.",
      "x-disclosure": "public"
    },
    "nominalCapacityAh": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Nominal capacity in ampere-hours.",
      "x-disclosure": "public"
    },
    "expectedLifetimeCycles": {
      "type": "integer",
      "minimum": 1,
      "description": "Expected lifetime in full charge-discharge cycles.",
      "x-disclosure": "public"
    },
    "co2ePerUnitKg": {
      "type": "number",
      "minimum": 0,
      "description": "Carbon footprint in kg CO2e per battery unit.",
      "x-disclosure": "public"
    },
    "recycledContentCobaltPct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "x-disclosure": "public"
    },
    "recycledContentLithiumPct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "x-disclosure": "public"
    },
    "recycledContentNickelPct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "x-disclosure": "public"
    },
    "stateOfHealthPct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Deprecated since v2.2.0 — narrower than Annex VII Part A, which defines state of health as state of certified energy for EV batteries and a five-parameter list for stationary storage and LMT. Populate stateOfHealth instead.",
      "x-disclosure": "individual"
    },
    "placedOnMarketDate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date the battery was placed on the EU market or put into service (ISO 8601, YYYY-MM-DD). Staged obligations attach by this date, not by the date of assessment: Art. 8(2) recycled-content minimums bind batteries placed on the market from 2031-08-18, Art. 8(3) from 2036-08-18, and Art. 10(4) disapplies the performance duties to batteries placed on the market before they applied. Without it no phase determination is possible.",
      "x-disclosure": "public"
    },
    "ratedCapacityKwh": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Rated energy in kilowatt-hours.",
      "x-disclosure": "public"
    },
    "carbonFootprintClass": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8,
      "description": "Carbon footprint performance class label per Art. 7(2), verbatim from the delegated act that established the scale. Not enumerated here: Art. 7(2) defines no labels and requires the Commission to review the number of classes and their thresholds every three years. Meaningless without carbonFootprintClassRulesetId and carbonFootprintClassRulesetVersion.",
      "x-disclosure": "public"
    },
    "carbonFootprintClassRulesetId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "description": "Identifier of the ruleset whose class boundaries produced carbonFootprintClass.",
      "x-disclosure": "public"
    },
    "carbonFootprintClassRulesetVersion": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32,
      "description": "Version of the ruleset identified by carbonFootprintClassRulesetId.",
      "x-disclosure": "public"
    },
    "dueDiligenceUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "URL to supply chain due diligence documentation (Arts. 48-53).",
      "x-disclosure": "public"
    },
    "cathodeMaterial": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/materialComposition"
      },
      "description": "Cathode active material composition.",
      "x-disclosure": "restricted"
    },
    "anodeMaterial": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/materialComposition"
      },
      "description": "Anode active material composition.",
      "x-disclosure": "restricted"
    },
    "electrolyteMaterial": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/materialComposition"
      },
      "description": "Electrolyte composition.",
      "x-disclosure": "restricted"
    },
    "criticalRawMaterials": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/criticalRawMaterial"
      },
      "description": "Critical raw materials per EU CRM Act 2024/1252.",
      "x-disclosure": "public"
    },
    "disassemblyInstructionsUrl": {
      "type": [
        "string",
        "null"
      ],
      "description": "URL or text for disassembly/dismantling instructions (Annex XIII point 2(c)).",
      "x-disclosure": "restricted"
    },
    "sohMethodology": {
      "type": [
        "string",
        "null"
      ],
      "description": "State-of-health determination methodology identifier.",
      "x-disclosure": "restricted"
    },
    "operatingTempMinC": {
      "type": [
        "number",
        "null"
      ],
      "description": "Minimum operating temperature in degrees Celsius.",
      "x-disclosure": "public"
    },
    "operatingTempMaxC": {
      "type": [
        "number",
        "null"
      ],
      "description": "Maximum operating temperature in degrees Celsius.",
      "x-disclosure": "public"
    },
    "ratedEnergyWh": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Rated energy in watt-hours (Wh).",
      "x-disclosure": "public"
    },
    "recycledContentLeadPct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Recycled lead content percentage (lead-acid batteries). Note: Art. 8(2)/(3) measure lead as the share present in the battery, whereas cobalt, lithium and nickel are measured in active materials.",
      "x-disclosure": "public"
    },
    "batteryWeightKg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Battery weight in kilograms.",
      "x-disclosure": "public"
    },
    "batteryType": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "portable",
        "industrial",
        "ev",
        "lmt",
        "starting-lighting-ignition",
        null
      ],
      "description": "Battery type category per regulation.",
      "x-disclosure": "public"
    },
    "roundTripEfficiencyPct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Round-trip energy efficiency at 50% SoC.",
      "x-disclosure": "public"
    },
    "internalResistanceMohm": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Internal resistance in milliohms at 50% SoC.",
      "x-disclosure": "public"
    },
    "stateOfHealth": {
      "description": "State-of-health parameters per Annex VII Part A, in the parameter set the battery's category requires. Required in the battery management system since 18 Aug 2024 (Art. 14(1)). Accessible only to persons with a legitimate interest (Annex XIII point 4(b)).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "parameterSet",
            "socePct"
          ],
          "properties": {
            "parameterSet": {
              "x-disclosure": "individual",
              "const": "electricVehicle"
            },
            "socePct": {
              "type": "number",
              "x-disclosure": "individual",
              "minimum": 0,
              "maximum": 100,
              "description": "State of certified energy (SOCE) — the only Annex VII Part A parameter for EV batteries."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "parameterSet",
            "remainingCapacityPct",
            "selfDischargeRatePctPerMonth"
          ],
          "properties": {
            "parameterSet": {
              "x-disclosure": "individual",
              "const": "stationaryOrLmt"
            },
            "remainingCapacityPct": {
              "type": "number",
              "x-disclosure": "individual",
              "minimum": 0,
              "maximum": 100,
              "description": "Annex VII Part A item 1 — unconditional."
            },
            "remainingPowerCapabilityPct": {
              "type": [
                "number",
                "null"
              ],
              "x-disclosure": "individual",
              "minimum": 0,
              "maximum": 100,
              "description": "Annex VII Part A item 2 — 'where possible'."
            },
            "remainingRoundTripEfficiencyPct": {
              "type": [
                "number",
                "null"
              ],
              "x-disclosure": "individual",
              "minimum": 0,
              "maximum": 100,
              "description": "Annex VII Part A item 3 — 'where possible'."
            },
            "selfDischargeRatePctPerMonth": {
              "type": "number",
              "x-disclosure": "individual",
              "minimum": 0,
              "description": "Annex VII Part A item 4 — unconditional."
            },
            "ohmicResistanceMohm": {
              "type": [
                "number",
                "null"
              ],
              "x-disclosure": "individual",
              "minimum": 0,
              "description": "Annex VII Part A item 5 — 'where possible'."
            }
          },
          "additionalProperties": false
        }
      ],
      "x-disclosure": "individual"
    },
    "recycledContentReportingYear": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 2000,
      "maximum": 2100,
      "description": "Calendar year the recycled-content shares pertain to, per Art. 8(1) ('for each battery model per year and per manufacturing plant'). Pair with manufacturingPlace.",
      "x-disclosure": "public"
    },
    "expectedLifetime": {
      "type": [
        "object",
        "null"
      ],
      "description": "Measured expected-lifetime parameters per Annex VII Part B. Stationary storage and LMT only. Accessible only to persons with a legitimate interest (Annex XIII point 4(d)).",
      "required": [
        "energyThroughputKwh",
        "capacityThroughputAh",
        "harmfulEvents",
        "fullEquivalentCycles"
      ],
      "properties": {
        "putIntoServiceDate": {
          "type": [
            "string",
            "null"
          ],
          "x-disclosure": "individual",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Annex VII Part B item 1, second half — 'where appropriate'. The date of manufacture is manufacturingDate."
        },
        "energyThroughputKwh": {
          "type": "number",
          "x-disclosure": "individual",
          "minimum": 0,
          "description": "Annex VII Part B item 2."
        },
        "capacityThroughputAh": {
          "type": "number",
          "x-disclosure": "individual",
          "minimum": 0,
          "description": "Annex VII Part B item 3."
        },
        "harmfulEvents": {
          "type": "object",
          "x-disclosure": "individual",
          "description": "Annex VII Part B item 4. The annex lists these 'such as', so the set is illustrative and every member is optional.",
          "properties": {
            "deepDischargeEvents": {
              "type": [
                "integer",
                "null"
              ],
              "x-disclosure": "individual",
              "minimum": 0
            },
            "hoursInExtremeTemperature": {
              "type": [
                "number",
                "null"
              ],
              "x-disclosure": "individual",
              "minimum": 0
            },
            "hoursChargingInExtremeTemperature": {
              "type": [
                "number",
                "null"
              ],
              "x-disclosure": "individual",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "fullEquivalentCycles": {
          "type": "number",
          "x-disclosure": "individual",
          "minimum": 0,
          "description": "Annex VII Part B item 5."
        }
      },
      "additionalProperties": false,
      "x-disclosure": "individual"
    }
  },
  "definitions": {
    "materialComposition": {
      "type": "object",
      "required": [
        "name",
        "weightPct"
      ],
      "properties": {
        "name": {
          "type": "string",
          "x-disclosure": "public",
          "minLength": 1,
          "description": "Chemical name or formula."
        },
        "weightPct": {
          "type": "number",
          "x-disclosure": "restricted",
          "minimum": 0,
          "maximum": 100,
          "description": "Weight percentage in the component."
        },
        "casNumber": {
          "type": [
            "string",
            "null"
          ],
          "x-disclosure": "public",
          "description": "CAS Registry Number."
        }
      },
      "additionalProperties": false
    },
    "criticalRawMaterial": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "x-disclosure": "public",
          "minLength": 1,
          "description": "Material name, e.g. cobalt, lithium."
        },
        "casNumber": {
          "type": [
            "string",
            "null"
          ],
          "x-disclosure": "public",
          "description": "CAS or EC number."
        },
        "weightGrams": {
          "type": [
            "number",
            "null"
          ],
          "x-disclosure": "public",
          "minimum": 0,
          "description": "Weight in grams present in the battery."
        },
        "countryOfOrigin": {
          "type": [
            "string",
            "null"
          ],
          "x-disclosure": "public",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country of primary extraction."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
