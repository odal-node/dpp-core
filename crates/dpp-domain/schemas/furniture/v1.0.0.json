{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.odal-node.io/dpp/furniture-v1.0.0.json",
  "$comment": "DRAFT — NOT IN FORCE. No act binding this product group is in force: every act the instrument catalog records as reaching it is provisional or anticipated, so this schema is our best reading of an instrument that has not been ratified and its field set may change without a migration path. Structural validation against it is not evidence of compliance, and a passport issued against it may not be representable once the act lands. The go sign is a single edit: set that binding's \"status\" to \"in_force\" in crates/dpp-domain/instruments/<id>.json. CI then requires this marker to be removed.",
  "title": "Odal Node — Furniture Sector Data (v1.0.0)",
  "description": "Furniture (including mattresses) fields per EU ESPR Working Plan 2025-2030. DPP mandate expected ~2028-2031.",
  "type": "object",
  "required": [
    "gtin",
    "productType",
    "primaryMaterial",
    "countryOfManufacture"
  ],
  "properties": {
    "gtin": {
      "type": "string",
      "pattern": "^[0-9]{14}$",
      "description": "14-digit Global Trade Item Number.",
      "x-disclosure": "public"
    },
    "productType": {
      "type": "string",
      "enum": [
        "chair",
        "table",
        "sofa",
        "mattress",
        "shelf",
        "bed",
        "other"
      ],
      "description": "EU furniture product type.",
      "x-disclosure": "public"
    },
    "primaryMaterial": {
      "type": "string",
      "enum": [
        "solid-wood",
        "engineered-wood",
        "metal",
        "upholstered",
        "mixed",
        "other"
      ],
      "description": "Primary construction material.",
      "x-disclosure": "public"
    },
    "countryOfManufacture": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country of manufacture.",
      "x-disclosure": "public"
    },
    "co2ePerUnitKg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Carbon footprint in kg CO2e per product unit.",
      "x-disclosure": "public"
    },
    "recycledContentPct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Recycled content as a percentage of total weight.",
      "x-disclosure": "public"
    },
    "repairabilityScore": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 10,
      "description": "Repairability score 0.0-10.0 (non-regulatory heuristic, not EN 45554 / EU 2023/1669).",
      "x-disclosure": "public"
    },
    "svhcSubstances": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/svhcSubstance"
      },
      "description": "SVHC substances present above 0.1% w/w per REACH Article 33.",
      "x-disclosure": "restricted"
    },
    "disassemblyInstructionsUrl": {
      "type": [
        "string",
        "null"
      ],
      "description": "URL to disassembly or deconstruction instructions.",
      "x-disclosure": "restricted"
    },
    "endOfLifeInstructions": {
      "type": [
        "string",
        "null"
      ],
      "description": "End-of-life disposal or recycling instructions.",
      "x-disclosure": "public"
    }
  },
  "definitions": {
    "svhcSubstance": {
      "type": "object",
      "required": [
        "casNumber",
        "substanceName",
        "concentrationPct"
      ],
      "properties": {
        "casNumber": {
          "type": "string",
          "x-disclosure": "restricted",
          "minLength": 1
        },
        "substanceName": {
          "type": "string",
          "x-disclosure": "restricted",
          "minLength": 1
        },
        "concentrationPct": {
          "type": "number",
          "x-disclosure": "restricted",
          "minimum": 0,
          "maximum": 100
        },
        "locationInProduct": {
          "type": [
            "string",
            "null"
          ],
          "x-disclosure": "restricted"
        },
        "scipNotificationId": {
          "type": [
            "string",
            "null"
          ],
          "x-disclosure": "restricted"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
